#!/bin/sh

set -o errexit
set -o nounset

gunicorn wsgi \
    --log-level=debug \
    --log-file=/var/log/gunicorn_access.log \
    --error-logfile=/var/log/gunicorn_error.log \
    --worker-class=sync \
    --workers=4 \
    --max-requests=1000 \
    --max-requests-jitter=100 \
    --timeout=720 \
    --worker-tmp-dir=/dev/shm \
    --bind 0.0.0.0:5000
